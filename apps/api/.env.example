# Runtime connection: a NON-superuser role subject to row-level security.
DATABASE_URL=postgres://saaserp_app:saaserp_app@localhost:5432/saaserp
# Migration connection: the role that owns the tables.
MIGRATION_DATABASE_URL=postgres://saaserp_owner:saaserp_owner@localhost:5432/saaserp
APP_DB_ROLE=saaserp_app
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
CORS_ORIGIN=http://localhost:5173
