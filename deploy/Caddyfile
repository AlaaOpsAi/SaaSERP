{
	email {$ACME_EMAIL}
}

# HTTPS for the whole app (web, API, operator console). http:// redirects to https:// automatically.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy app:4000
}

# Extra sites served by this same Caddy (e.g. static apps on other subdomains).
# Drop one site block per file into deploy/sites/<name>.caddy and reload Caddy:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml exec caddy caddy reload --config /etc/caddy/Caddyfile
import sites/*.caddy
